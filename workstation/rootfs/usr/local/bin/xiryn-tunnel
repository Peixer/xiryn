#!/bin/bash
# xiryn-tunnel <minutes>
# Prints a temporary public https address for this desktop (a Cloudflare
# quick tunnel to noVNC), so a hand-off can be done from a phone. The tunnel
# closes itself when the time is up. The desktop still asks for its password.

set -u

minutes="${1:-30}"
dir=/tmp/xiryn/tunnel
mkdir -p "$dir"
now=$(date +%s)

# Reuse a running tunnel while it has at least half its time left
if pgrep -x cloudflared >/dev/null && [ -s "$dir/url" ] \
  && [ $(( $(cat "$dir/expires" 2>/dev/null || echo 0) - now )) -ge $(( minutes * 30 )) ]; then
  cat "$dir/url"
  exit 0
fi

pkill -x cloudflared 2>/dev/null
rm -f "$dir/url" "$dir/log"
echo $(( now + minutes * 60 )) > "$dir/expires"
setsid -f timeout "$(( minutes * 60 ))" \
  cloudflared tunnel --no-autoupdate --url http://localhost:6080 \
  >"$dir/log" 2>&1 </dev/null

for _ in $(seq 80); do
  url=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$dir/log" | head -1)
  if [ -n "$url" ]; then
    # A brand-new address takes a few seconds to resolve. Hand it out only
    # once it answers from the internet: a phone that tries too early can
    # remember the failure for a while.
    for _ in $(seq 40); do
      [ "$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$url/xiryn.html")" = 200 ] && break
      sleep 1
    done
    echo "$url" > "$dir/url"
    echo "$url"
    exit 0
  fi
  sleep 0.25
done

echo "Couldn't open a tunnel: $(tail -n 3 "$dir/log")" >&2
exit 1
