#!/usr/bin/env python3
"""Run one program with a vault secret on stdin or in one environment variable.

Stdin is a 4-byte big-endian length and then that many secret bytes. The
secret is never written to a file, never put on a command line, and never
printed. This process calls prctl(PR_SET_DUMPABLE, 0) before it reads the
secret. The command is stopped at exec, marked not dumpable, and only then
receives the secret, so another process in the workstation cannot read it
through /proc. Captured output has the secret removed before it is written.

The machine code below was assembled from the instruction sequences in
arch_blobs(). x86_64 is what the tests run. aarch64 uses the same steps.
"""

from __future__ import annotations

import base64
import ctypes
import errno
import json
import os
import platform
import re
import selectors
import signal
import struct
import sys
import time
import urllib.parse

MAX_SECRET = 16_384
MAX_OUTPUT = 200_000
SECRET_FD = 100

PTRACE_TRACEME = 0
PTRACE_PEEKDATA = 2
PTRACE_POKEDATA = 5
PTRACE_CONT = 7
PTRACE_DETACH = 17
PTRACE_SETOPTIONS = 0x4200
PTRACE_GETREGSET = 0x4204
PTRACE_SETREGSET = 0x4205
PTRACE_O_TRACEEXEC = 0x10
PTRACE_O_EXITKILL = 0x00100000
PTRACE_EVENT_EXEC = 4
NT_PRSTATUS = 1

# Assembled stubs. Lengths and patch slots are checked at startup.
X86_TEXT = bytes.fromhex(
    "b80900000031ffbe00100000ba0700000041ba2200000049c7c0ffffffff4531c90f05cc"
    "52575641524153515053b89d000000bf0400000031f631d24531d20f05b89d000000bf01"
    "000000be0900000031d24531d20f055b5859415b415a5e5f5acc57565250b800000000bf"
    "6400000048be8877665544332211ba889900000f05b803000000bf640000000f05585a5e"
    "5fff25000000001122334455667788ff25000000001122334455667788"
)
ARM_TEXT = bytes.fromhex(
    "c81b80d2000080d2010082d2e20080d2430480d204008092050080d2010000d4000020d4"
    "e007bfa9e20fbfa9e87bbfa9e81480d2800080d2010080d2020080d2030080d2010000d4"
    "e81480d2200080d2210180d2020080d2030080d2010000d4e87bc1a8e20fc1a8e007c1a8"
    "000020d4e007bfa9e223bfa9e80780d2800c80d24101005862010058010000d4280780d2"
    "800c80d2010000d4e223c1a8e007c1a8d000005800021fd6887766554433221188990000"
    "0000000011223344556677885000005800021fd61122334455667788"
)

libc = ctypes.CDLL("libc.so.6", use_errno=True)


class Fail(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


def ptrace(req: int, pid: int, addr: int = 0, data: int = 0) -> int:
    libc.ptrace.restype = ctypes.c_long
    libc.ptrace.argtypes = [
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_void_p,
    ]
    ctypes.set_errno(0)
    rc = libc.ptrace(
        ctypes.c_ulong(req),
        pid,
        ctypes.c_void_p(addr),
        ctypes.c_void_p(data),
    )
    err = ctypes.get_errno()
    if rc == -1 and err:
        raise OSError(err, os.strerror(err))
    return int(rc)


def peek(pid: int, addr: int) -> int:
    libc.ptrace.restype = ctypes.c_ulong
    libc.ptrace.argtypes = [
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_void_p,
    ]
    ctypes.set_errno(0)
    value = libc.ptrace(
        ctypes.c_ulong(PTRACE_PEEKDATA),
        pid,
        ctypes.c_void_p(addr),
        None,
    )
    err = ctypes.get_errno()
    if err:
        raise OSError(err, os.strerror(err))
    return int(value)


def poke(pid: int, addr: int, value: int) -> None:
    libc.ptrace.restype = ctypes.c_long
    libc.ptrace.argtypes = [
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_ulong,
    ]
    ctypes.set_errno(0)
    rc = libc.ptrace(
        ctypes.c_ulong(PTRACE_POKEDATA),
        pid,
        ctypes.c_void_p(addr),
        ctypes.c_ulong(value & ((1 << 64) - 1)),
    )
    err = ctypes.get_errno()
    if rc == -1 and err:
        raise OSError(err, os.strerror(err))


def read_bytes(pid: int, addr: int, size: int) -> bytes:
    start = addr & ~7
    end = (addr + size + 7) & ~7
    raw = bytearray()
    for word in range(start, end, 8):
        raw += struct.pack("<Q", peek(pid, word))
    return bytes(raw[addr - start : addr - start + size])


def write_bytes(pid: int, addr: int, blob: bytes) -> None:
    start = addr & ~7
    end = (addr + len(blob) + 7) & ~7
    raw = bytearray()
    for word in range(start, end, 8):
        raw += struct.pack("<Q", peek(pid, word))
    raw[addr - start : addr - start + len(blob)] = blob
    for index, word in enumerate(range(start, end, 8)):
        poke(pid, word, struct.unpack_from("<Q", raw, index * 8)[0])


def getregs(pid: int) -> list[int]:
    buf = ctypes.create_string_buffer(34 * 8)

    class IOVec(ctypes.Structure):
        _fields_ = [("base", ctypes.c_void_p), ("len", ctypes.c_size_t)]

    vec = IOVec(ctypes.addressof(buf), ctypes.sizeof(buf))
    libc.ptrace.restype = ctypes.c_long
    libc.ptrace.argtypes = [
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_void_p,
    ]
    ctypes.set_errno(0)
    rc = libc.ptrace(
        ctypes.c_ulong(PTRACE_GETREGSET),
        pid,
        ctypes.c_void_p(NT_PRSTATUS),
        ctypes.byref(vec),
    )
    err = ctypes.get_errno()
    if rc == -1 and err:
        raise OSError(err, os.strerror(err))
    size = int(vec.len)
    if size < 8 or size % 8:
        raise Fail("Couldn't read the program's registers.")
    return list(struct.unpack_from(f"<{size // 8}Q", buf.raw))


def setregs(pid: int, regs: list[int]) -> None:
    raw = struct.pack(f"<{len(regs)}Q", *regs)
    buf = ctypes.create_string_buffer(raw)

    class IOVec(ctypes.Structure):
        _fields_ = [("base", ctypes.c_void_p), ("len", ctypes.c_size_t)]

    vec = IOVec(ctypes.addressof(buf), len(raw))
    libc.ptrace.restype = ctypes.c_long
    libc.ptrace.argtypes = [
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_void_p,
    ]
    ctypes.set_errno(0)
    rc = libc.ptrace(
        ctypes.c_ulong(PTRACE_SETREGSET),
        pid,
        ctypes.c_void_p(NT_PRSTATUS),
        ctypes.byref(vec),
    )
    err = ctypes.get_errno()
    if rc == -1 and err:
        raise OSError(err, os.strerror(err))


def arch_layout() -> dict[str, int | bytes]:
    machine = platform.machine()
    if machine == "x86_64":
        text = X86_TEXT
        if len(text) != 0xAD:
            raise Fail("The x86_64 stub is the wrong length.")
        return {
            "text": text,
            "pc": 16,
            "ret": 10,
            "sp": 19,
            "mmap": text[0x00:0x24],
            "prctl": text[0x24:0x62],
            "break_size": 1,
        }
    if machine in ("aarch64", "arm64"):
        text = ARM_TEXT
        if len(text) != 0xD0:
            raise Fail("The aarch64 stub is the wrong length.")
        return {
            "text": text,
            "pc": 32,
            "ret": 0,
            "sp": 31,
            "mmap": text[0x00:0x24],
            "prctl": text[0x24:0x70],
            "break_size": 4,
        }
    raise Fail("This machine's processor isn't supported for a vault command.")


def stage_blob(layout: dict[str, int | bytes], via: str, addr: int, length: int, entry: int) -> bytes:
    text = layout["text"]
    assert isinstance(text, bytes)
    machine = platform.machine()
    if machine == "x86_64":
        if via == "env":
            blob = bytearray(text[0x62:0x9F])
            blob[0x10:0x18] = addr.to_bytes(8, "little")
            blob[0x19:0x1D] = length.to_bytes(4, "little")
            blob[0x35:0x3D] = entry.to_bytes(8, "little")
            return bytes(blob)
        blob = bytearray(text[0x9F:])
        blob[6:14] = entry.to_bytes(8, "little")
        return bytes(blob)
    if via == "env":
        blob = bytearray(text[0x70:0xC0])
        blob[0x38:0x40] = addr.to_bytes(8, "little")
        blob[0x40:0x48] = length.to_bytes(8, "little")
        blob[0x48:0x50] = entry.to_bytes(8, "little")
        return bytes(blob)
    blob = bytearray(text[0xC0:])
    blob[8:16] = entry.to_bytes(8, "little")
    return bytes(blob)


def wait_stop(pid: int) -> int:
    _, status = os.waitpid(pid, 0)
    if os.WIFSTOPPED(status):
        return status
    if os.WIFEXITED(status):
        # exec failed in the child (the program is missing, or it could not
        # be started). The child exits 127 before the secret is written.
        if os.WEXITSTATUS(status) == 127:
            raise Fail("That program is not on this machine.", 127)
        raise Fail("The program exited before it could be locked.", 127)
    raise Fail("The program stopped unexpectedly.", 127)


def event(status: int) -> int:
    return (status >> 16) & 0xFF


def dumpable_locked(pid: int) -> bool:
    try:
        fd = os.open(f"/proc/{pid}/environ", os.O_RDONLY)
    except OSError as error:
        return error.errno == errno.EACCES
    os.close(fd)
    return False


def thread_group(pid: str) -> str:
    try:
        with open(f"/proc/{pid}/status", encoding="ascii", errors="replace") as handle:
            for line in handle:
                if line.startswith("Tgid:"):
                    return line.split()[1]
    except OSError:
        return pid
    return pid


# The secret is written to a pipe the child already has open. Another process
# can open that pipe through /proc only while the child is still dumpable.
# After the lock, new opens fail, and the child's own end is hidden. The only
# end we should still be able to see is our write end. Anything else means
# someone already has a copy, so the secret is not written.
def assert_pipe_private(write_fd: int) -> None:
    try:
        own = os.readlink(f"/proc/self/fd/{write_fd}")
    except OSError as error:
        raise Fail("Couldn't keep the secret private.") from error
    if not own.startswith("pipe:["):
        raise Fail("Couldn't keep the secret private.")
    groups: set[str] = set()
    try:
        names = os.listdir("/proc")
    except OSError as error:
        raise Fail("Couldn't keep the secret private.") from error
    for name in names:
        if not name.isdigit():
            continue
        fd_dir = f"/proc/{name}/fd"
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(f"{fd_dir}/{fd}")
            except OSError:
                continue
            if target == own:
                groups.add(thread_group(name))
                break
    if groups != {thread_group(str(os.getpid()))}:
        raise Fail("Couldn't keep the secret private.")


def find_placeholder(pid: int, sp: int, name: str, length: int) -> int:
    prefix = name.encode() + b"="
    needle = prefix + (b"X" * length)
    argc = peek(pid, sp)
    if argc < 0 or argc > 10_000:
        raise Fail("Couldn't find the command's environment.")
    slot = sp + 8 * (argc + 2)
    for _ in range(2_000):
        ptr = peek(pid, slot)
        if ptr == 0:
            break
        try:
            head = read_bytes(pid, ptr, len(needle) + 1)
        except OSError:
            head = b""
        if head.startswith(needle) and head[len(needle) : len(needle) + 1] == b"\0":
            return ptr + len(prefix)
        slot += 8
    raise Fail("Couldn't prepare the environment variable.")


def lock_and_inject(
    pid: int,
    via: str,
    secret: bytes,
    env_name: str | None,
    write_fd: int,
) -> None:
    layout = arch_layout()
    pc_i = int(layout["pc"])
    ret_i = int(layout["ret"])
    sp_i = int(layout["sp"])
    mmap = layout["mmap"]
    prctl = layout["prctl"]
    assert isinstance(mmap, bytes) and isinstance(prctl, bytes)
    status = wait_stop(pid)
    if os.WSTOPSIG(status) not in (signal.SIGSTOP, 19):
        raise Fail("The program didn't stop for setup.")
    ptrace(PTRACE_SETOPTIONS, pid, 0, PTRACE_O_TRACEEXEC | PTRACE_O_EXITKILL)
    ptrace(PTRACE_CONT, pid, 0, 0)
    status = wait_stop(pid)
    if event(status) != PTRACE_EVENT_EXEC:
        raise Fail("The program didn't start.", 127)
    saved = getregs(pid)
    entry = saved[pc_i]
    original = read_bytes(pid, entry, len(mmap))
    try:
        write_bytes(pid, entry, mmap)
        ptrace(PTRACE_CONT, pid, 0, 0)
        wait_stop(pid)
        mapped = getregs(pid)[ret_i]
        if mapped == 0 or mapped >= 1 << 63:
            raise Fail("Couldn't prepare a private page for the program.")
        placeholder = 0
        if via == "env":
            assert env_name is not None
            placeholder = find_placeholder(pid, saved[sp_i], env_name, len(secret))
        stage = stage_blob(layout, via, placeholder, len(secret), entry)
        write_bytes(pid, mapped, prctl + stage)
    finally:
        write_bytes(pid, entry, original)
    regs = saved[:]
    regs[pc_i] = mapped
    setregs(pid, regs)
    ptrace(PTRACE_CONT, pid, 0, 0)
    wait_stop(pid)
    if not dumpable_locked(pid):
        raise Fail("Couldn't hide the program from other processes.")
    assert_pipe_private(write_fd)
    os.write(write_fd, secret)
    os.close(write_fd)
    # The break instruction has already completed. Resume at the next one,
    # which copies the secret (env) or jumps to the real entry (stdin).
    now = getregs(pid)
    break_at = mapped + len(prctl) - int(layout["break_size"])
    resume = mapped + len(prctl)
    if now[pc_i] == break_at:
        now[pc_i] = resume
    elif now[pc_i] != resume:
        raise Fail("Couldn't resume the program after locking it.")
    setregs(pid, now)
    ptrace(PTRACE_DETACH, pid, 0, 0)


def spawn(
    via: str, command: list[str], env: dict[str, str], secret_r: int, secret_w: int
) -> tuple[int, int, int]:
    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(out_r)
            os.close(err_r)
            os.close(secret_w)
            os.setsid()
            os.dup2(out_w, 1)
            os.dup2(err_w, 2)
            os.close(out_w)
            os.close(err_w)
            if via == "stdin":
                os.dup2(secret_r, 0)
            else:
                null = os.open("/dev/null", os.O_RDONLY)
                os.dup2(null, 0)
                os.close(null)
                os.dup2(secret_r, SECRET_FD)
            os.close(secret_r)
            os.closerange(3, SECRET_FD)
            os.closerange(SECRET_FD + 1, 1024)
            ptrace(PTRACE_TRACEME, 0, 0, 0)
            os.kill(os.getpid(), signal.SIGSTOP)
            os.execvpe(command[0], command, env)
        except Exception:
            os._exit(127)
        os._exit(127)
    os.close(out_w)
    os.close(err_w)
    os.close(secret_r)
    return pid, out_r, err_r


def read_capped(fd: int, limit: int) -> tuple[bytes, bool]:
    chunks: list[bytes] = []
    total = 0
    while total < limit:
        try:
            block = os.read(fd, min(65536, limit - total))
        except OSError:
            break
        if not block:
            return b"".join(chunks), False
        chunks.append(block)
        total += len(block)
    return b"".join(chunks), True


def capture(pid: int, out_r: int, err_r: int, timeout: int) -> tuple[int, bytes, bytes, bool]:
    os.set_blocking(out_r, False)
    os.set_blocking(err_r, False)
    sel = selectors.DefaultSelector()
    sel.register(out_r, selectors.EVENT_READ)
    sel.register(err_r, selectors.EVENT_READ)
    streams = {out_r: bytearray(), err_r: bytearray()}
    open_fds = {out_r, err_r}
    truncated = False
    timed_out = False
    deadline = time.monotonic() + timeout
    while open_fds:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break
        events = sel.select(remaining)
        if not events:
            timed_out = True
            break
        for key, _ in events:
            fd = key.fileobj
            assert isinstance(fd, int)
            buf = streams[fd]
            if len(buf) >= MAX_OUTPUT:
                truncated = True
                timed_out = True
                break
            try:
                block = os.read(fd, 65536)
            except BlockingIOError:
                continue
            if not block:
                sel.unregister(fd)
                open_fds.discard(fd)
                continue
            room = MAX_OUTPUT - len(buf)
            buf += block[:room]
            if len(block) > room:
                truncated = True
                timed_out = True
                break
        if timed_out:
            break
    if timed_out:
        try:
            os.killpg(pid, signal.SIGKILL)
        except OSError:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    _, status = os.waitpid(pid, 0)
    for fd in (out_r, err_r):
        os.set_blocking(fd, True)
        extra, hit = read_capped(fd, MAX_OUTPUT - len(streams[fd]))
        streams[fd] += extra
        truncated = truncated or hit
        os.close(fd)
    if os.WIFEXITED(status):
        code = os.WEXITSTATUS(status)
    elif os.WIFSIGNALED(status):
        code = 128 + os.WTERMSIG(status)
    else:
        code = 1
    if timed_out and not truncated:
        code = 124
    return code, bytes(streams[out_r]), bytes(streams[err_r]), truncated


def replacement(secret: bytes) -> bytes:
    for token in (b"[redacted]", b"<redacted>", b"***"):
        if token not in secret:
            return token
    return "\ufffd".encode()


def spellings(secret: bytes) -> list[bytes]:
    forms = [secret]
    b64 = base64.b64encode(secret)
    b64url = base64.urlsafe_b64encode(secret)
    forms.extend([b64, b64.rstrip(b"="), b64url, b64url.rstrip(b"=")])
    hexa = secret.hex().encode()
    forms.extend([hexa, hexa.upper()])
    try:
        text = secret.decode("utf-8")
    except UnicodeDecodeError:
        text = ""
    if text:
        forms.append(urllib.parse.quote(text, safe="-_.!~*'()").encode())
        forms.append(json.dumps(text, ensure_ascii=False)[1:-1].encode())
    unique = []
    seen: set[bytes] = set()
    for form in forms:
        if form and form not in seen:
            seen.add(form)
            unique.append(form)
    unique.sort(key=len, reverse=True)
    return unique


def redact(data: bytes, secret: bytes) -> bytes:
    token = replacement(secret)
    for form in spellings(secret):
        data = data.replace(form, token)
    return re.sub(br"/tmp/xiryn/vault/\S*", token, data)


def read_secret() -> bytes:
    header = read_exact(4)
    length = int.from_bytes(header, "big")
    if length < 1 or length > MAX_SECRET:
        raise Fail("That vault field can't be passed to a program.")
    return read_exact(length)


def read_exact(size: int) -> bytes:
    buf = bytearray()
    while len(buf) < size:
        block = os.read(0, size - len(buf))
        if not block:
            raise Fail("The secret stream ended early.")
        buf += block
    return bytes(buf)


def parse_cli(argv: list[str]) -> tuple[str, str | None, int, list[str]]:
    via = ""
    env_name = None
    timeout = 0
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            index += 1
            break
        if arg == "--via" and index + 1 < len(argv):
            via = argv[index + 1]
            index += 2
            continue
        if arg == "--env-name" and index + 1 < len(argv):
            env_name = argv[index + 1]
            index += 2
            continue
        if arg == "--timeout" and index + 1 < len(argv):
            try:
                timeout = int(argv[index + 1])
            except ValueError:
                raise Fail("The timeout is not a number.") from None
            index += 2
            continue
        raise Fail("Bad arguments to xiryn-secret-exec.")
    command = argv[index:]
    if via not in ("stdin", "env"):
        raise Fail("Pass --via stdin or --via env.")
    if via == "env" and not env_name:
        raise Fail("An environment variable needs a name.")
    if timeout < 1 or timeout > 900:
        raise Fail("The timeout is out of range.")
    if not command or not command[0]:
        raise Fail("Name the program to run.")
    return via, env_name, timeout, command


def main() -> int:
    # Hide this process before the secret is read. A failure here is fatal:
    # continuing would leave the secret where other processes can read it.
    if libc.prctl(4, 0, 0, 0, 0) != 0:
        sys.stderr.write("Couldn't hide the vault helper.\n")
        return 1
    try:
        via, env_name, timeout, command = parse_cli(sys.argv[1:])
        secret = bytearray(read_secret())
    except Fail as error:
        sys.stderr.write(str(error) + "\n")
        return error.code
    if via == "env" and b"\0" in secret:
        sys.stderr.write("This value can't go in an environment variable. Use stdin.\n")
        return 1
    secret_r, secret_w = os.pipe()
    env = os.environ.copy()
    if via == "env" and env_name is not None:
        env[env_name] = "X" * len(secret)
    pid = 0
    try:
        pid, out_r, err_r = spawn(via, command, env, secret_r, secret_w)
        try:
            lock_and_inject(pid, via, bytes(secret), env_name, secret_w)
        except Exception:
            try:
                os.close(secret_w)
            except OSError:
                pass
            raise
        secret_w = -1
        code, out, err, truncated = capture(pid, out_r, err_r, timeout)
        pid = 0
        body = redact(out, bytes(secret))
        err_text = redact(err, bytes(secret))
        if err_text:
            body += (b"\n" if body else b"") + err_text
        if truncated:
            body += b"\n[output truncated]\n"
        if code == 124:
            body += f"\n[timed out after {timeout}s]\n".encode()
        sys.stdout.buffer.write(body)
        return code
    except Fail as error:
        sys.stderr.write(str(error) + "\n")
        return error.code
    except OSError as error:
        if error.errno == errno.ENOENT:
            sys.stderr.write("That program is not on this machine.\n")
            return 127
        sys.stderr.write("The program could not be started.\n")
        return 1
    finally:
        secret[:] = b"\0" * len(secret)
        if pid:
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            try:
                os.waitpid(pid, 0)
            except ChildProcessError:
                pass


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0) from None
