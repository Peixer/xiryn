[Unit]
Description=Xiryn (blue)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=xiryn
Group=xiryn
SupplementaryGroups=docker
WorkingDirectory=/opt/xiryn-blue
Environment=NODE_ENV=production
Environment=XIRYN_COLOUR=blue
# EnvironmentFile overrides Environment=, and a later file overrides an earlier
# one. shared.env is the old production file and may still name /opt/xiryn/data.
# The colour file is second so this unit keeps its own database, ports, and
# vault-key directory.
EnvironmentFile=-/etc/xiryn/shared.env
EnvironmentFile=/etc/xiryn/blue.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/xiryn/colours/blue /var/lib/xiryn/deploy /opt/xiryn-blue/.next/cache /run/docker.sock /var/run/docker.sock
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
