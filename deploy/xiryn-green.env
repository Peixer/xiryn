# Loaded after /etc/xiryn/shared.env. A later EnvironmentFile wins, so these
# values stay with this colour even when the shared file still names the old
# production data directory.
XIRYN_PORT=6896
XIRYN_DESKTOP_PROXY_PORT=6897
XIRYN_DATA_DIR=/var/lib/xiryn/colours/green
XIRYN_VAULT_KEY_DIR=/etc/xiryn/vault
XIRYN_DEPLOY_DIR=/var/lib/xiryn/deploy
# The installer appends XIRYN_VAULT_ACCOUNT (16 hex digits). That is the
# vault key name from the database path used before blue/green.
