# ─────────────────────────────────────────────────────────────────────────────
#  Xiryn — environment
#
#  Copy this file to `.env` (or run `npm run setup`) and fill in what you use.
#  Everything is optional except ONE model provider. Any value can also be set
#  later from Settings in the app; values saved there take precedence over this
#  file and live only in ./data/xiryn.db on your machine.
# ─────────────────────────────────────────────────────────────────────────────


# ── Models ── at least one provider ─────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Local runtimes need only an endpoint (and no key). `npm run setup:local`
# installs Ollama, downloads a model that fits this computer and sets both
# OLLAMA_BASE_URL and XIRYN_DEFAULT_MODEL for you.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Any other OpenAI-compatible API (vLLM, Together, Fireworks, LiteLLM, …)
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_API_KEY=

# Amazon Bedrock. Leave the keys empty on an EC2 instance with a role that
# can call bedrock:InvokeModel (the default credential chain). Set AWS_REGION
# — or save a region in Settings — to turn Bedrock on. The built-in default
# eu-west-3 does not, by itself, enable it.
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional VPC endpoint for the runtime API. Used for AWS_REGION only.
# BEDROCK_BASE_URL=https://bedrock-runtime.eu-west-3.amazonaws.com
# Suggested model: bedrock/eu.anthropic.claude-sonnet-5-5
# Other regions to list and call. us-east-2 adds Llama 3.3 70B (Ohio):
# bedrock/meta.llama3-3-70b-instruct-v1:0
# XIRYN_BEDROCK_EXTRA_REGIONS=us-east-2
# Optional pins and output ceilings (model-id=value, comma-separated)
# XIRYN_BEDROCK_MODEL_REGIONS=meta.llama3-3-70b-instruct-v1:0=us-east-2
# XIRYN_BEDROCK_MAX_OUTPUT=eu.amazon.nova-pro-v1:0=10000
# Prompt cache for Bedrock Claude and Nova, and for Claude sent through
# OpenRouter (openrouter/anthropic/…). On unless this is off, 0, false, or no.
# XIRYN_PROMPT_CACHE=on

# Google OAuth for the built-in Gmail and Calendar connectors. The refresh
# token is stored sealed in the database after you connect from Settings;
# you can also paste one here. See docs/mcp.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# XIRYN_GMAIL=on
# XIRYN_CALENDAR=on

# The model agents use unless they pick their own, as provider/model-id.
# Leave empty to use the first configured provider's recommended model.
# XIRYN_DEFAULT_MODEL=openai/gpt-6-luna

# Upper bound on tool calls in a single agent turn
# XIRYN_MAX_STEPS=40

# Dollars a month for paid models. Once it's spent, turns on paid models wait
# until the 1st; local models keep working. Empty means no limit.
# XIRYN_MONTHLY_BUDGET=20


# ── Workstations ── one Docker container per agent, on this computer ───────
# Needs Docker (npm run setup installs and starts it). Nothing to configure;
# these only change the defaults.

# Limits for each agent's machine
# XIRYN_WORKSTATION_CPUS=2
# XIRYN_WORKSTATION_MEMORY_GB=4
# Minutes of inactivity before a workstation stops itself (files are kept;
# 0 keeps it running)
# XIRYN_WORKSTATION_AUTO_STOP_MINUTES=15
# Disposable workstations: delete a machine and its files this many minutes
# after it stops (0 = as soon as it stops). Unset keeps files until you reset
# the agent.
# XIRYN_WORKSTATION_AUTO_DELETE_MINUTES=60
# Telegram hand-offs include a link that opens the agent's desktop on your
# phone, through a temporary Cloudflare quick tunnel. "off" leaves it out.
# XIRYN_PHONE_TAKEOVER=on


# ── Web ── Firecrawl: search and page extraction ────────────────────────────
# https://www.firecrawl.dev/app/api-keys

FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev


# ── Remote access ── Telegram (optional) ────────────────────────────────────
# Create a bot with @BotFather and paste its token here or in Settings.
# Then pair your account from Settings → Remote access. See docs/telegram.md.

TELEGRAM_BOT_TOKEN=
# Skip pairing by naming your numeric Telegram user id directly
# TELEGRAM_OWNER_ID=
# Only for self-hosted Bot API servers
# TELEGRAM_API_URL=https://api.telegram.org
# When a task you started in the app finishes, Telegram tells you:
# long = tasks of a minute or more (default) · all · off
# XIRYN_TELEGRAM_NOTIFY=long


# ── Server ──────────────────────────────────────────────────────────────────

# Where the database lives (default ./data)
# XIRYN_DATA_DIR=./data

# The address you open Xiryn at. Used for Telegram links, the Google OAuth
# redirect, and (when it is not loopback) the desktop stream. Behind Caddy
# this is the public https origin, with no trailing slash.
# XIRYN_URL=http://127.0.0.1:6796

# Loopback port that forwards /desktop/<agent>/websockify to an agent's VNC.
# Only used when XIRYN_URL is a public origin. "off" disables it.
# XIRYN_DESKTOP_PROXY_PORT=6797
# XIRYN_DESKTOP_PROXY=on

# When you open it, Xiryn asks GitHub's public API whether a newer version is
# out (and how many stars it has) to show an Update button. "off" stops it.
# XIRYN_UPDATE_CHECK=on

# With no Xiryn tab open (say, running with `npm run background`), the
# operating system shows a notification when an agent finishes or needs you.
# "off" stops it.
# XIRYN_DESKTOP_NOTIFY=on

# Phone notification when a task finishes or needs you, including on a machine
# with no desktop. Nothing is sent until this is set. The URL is a secret and
# is never logged. http and https only.
# XIRYN_NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-topic
# ntfy, slack, or json
# XIRYN_NOTIFY_WEBHOOK_FORMAT=json
# finished, failed, approval, takeover, secret — or none
# XIRYN_NOTIFY_WEBHOOK_TRIGGERS=finished,failed,approval,takeover,secret
# "on" adds at most 140 characters of the reply. Off by default.
# XIRYN_NOTIFY_WEBHOOK_PREVIEW=off

# Xiryn has no login and only answers on localhost. If you deliberately put it
# behind your own authenticating reverse proxy, list the extra hostnames here.
# XIRYN_ALLOWED_HOSTS=xiryn.example.internal

# Let GitHub, Zapier, or a script start a routine:
#   POST /api/hooks/routines/<id>
#   Authorization: Bearer <this token>    or    X-Xiryn-Token: <this token>
# The body (64 KB at most) is handed to the agent as untrusted data. Writes
# still wait for approval. Unset, the endpoint answers 404. A public host has
# to be listed in XIRYN_ALLOWED_HOSTS. See deploy/Caddyfile to skip basic auth
# on /api/hooks/* only.
# XIRYN_HOOKS_TOKEN=
